[{"gap": 0.0, "shot": 1, "spk": "N", "line": "On November eighteenth, eighteen eighty-three, New York's church bells rang *noon.*", "dur": 4.24, "words": [{"w": "On", "hl": false, "t": 0.0}, {"w": "November", "hl": false, "t": 0.189}, {"w": "eighteenth,", "hl": false, "t": 0.631}, {"w": "eighteen", "hl": false, "t": 1.41}, {"w": "eighty-three,", "hl": false, "t": 1.784}, {"w": "New", "hl": false, "t": 2.54}, {"w": "York's", "hl": false, "t": 2.768}, {"w": "church", "hl": false, "t": 3.12}, {"w": "bells", "hl": false, "t": 3.473}, {"w": "rang", "hl": false, "t": 3.742}, {"w": "noon.", "hl": true, "t": 3.97}], "env": []}, {"gap": 0.1, "shot": 1, "spk": "N", "line": "Four minutes later\u2026 noon rang *again.*", "dur": 1.97, "words": [{"w": "Four", "hl": false, "t": 0.0}, {"w": "minutes", "hl": false, "t": 0.312}, {"w": "later\u2026", "hl": false, "t": 0.721}, {"w": "noon", "hl": false, "t": 1.081}, {"w": "rang", "hl": false, "t": 1.393}, {"w": "again.", "hl": true, "t": 1.658}], "env": []}, {"gap": 0.05, "shot": 2, "spk": "N", "line": "Blame the *railroads.* And one man with a clock.", "dur": 2.45, "words": [{"w": "Blame", "hl": false, "t": 0.0}, {"w": "the", "hl": false, "t": 0.327}, {"w": "railroads.", "hl": true, "t": 0.479}, {"w": "And", "hl": false, "t": 1.24}, {"w": "one", "hl": false, "t": 1.41}, {"w": "man", "hl": false, "t": 1.618}, {"w": "with", "hl": false, "t": 1.826}, {"w": "a", "hl": false, "t": 1.996}, {"w": "clock.", "hl": false, "t": 2.166}], "env": []}, {"gap": 0.0, "shot": 3, "spk": "N", "line": "That morning, he *stopped* New York's master clock\u2026", "dur": 2.33, "words": [{"w": "That", "hl": false, "t": 0.0}, {"w": "morning,", "hl": false, "t": 0.194}, {"w": "he", "hl": false, "t": 0.74}, {"w": "stopped", "hl": true, "t": 0.91}, {"w": "New", "hl": false, "t": 1.232}, {"w": "York's", "hl": false, "t": 1.44}, {"w": "master", "hl": false, "t": 1.762}, {"w": "clock\u2026", "hl": false, "t": 2.046}], "env": []}, {"gap": 0.05, "shot": 3, "spk": "N", 